# Hark Protocol - environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Shared ---
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hark
HARK_API_URL=http://localhost:4021
WEB_URL=http://localhost:3000

# --- API ---
API_PORT=4021

# x402 / Hedera settlement (Phase 3 - not used yet)
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=hedera:testnet
HEDERA_PAY_TO_ACCOUNT_ID=0.0.xxxxx
# Same account as above; used only as the API's HCS operator (topic create + message submit).
HEDERA_PAY_TO_PRIVATE_KEY=0x...
HARK_REACH_PRICE_TINYBAR=100000

# HCS audit trail (CLAUDE.md section 35). Leave blank to auto-create a topic
# on API startup (logged once at boot - pin it here afterwards).
HARK_HCS_TOPIC_ID=

# Publisher revenue share. 8000 bps = 80% to the publisher, 20% to the
# protocol. Payouts are batched (pnpm payout:run), not per-reach, and only
# fire once a publisher's accrued balance clears HARK_PAYOUT_MIN_TINYBAR.
HARK_PUBLISHER_SHARE_BPS=8000
HARK_PAYOUT_MIN_TINYBAR=1000000

# Demo publisher API secret (Bearer token used by the Demo Publisher app / seed data)
DEMO_PUBLISHER_KEY=replace-me
# Optional: Hedera account the Demo Publisher's revenue-share payout goes to.
# Leave unset to just accrue an unpaid balance (pnpm payout:run skips it).
DEMO_PUBLISHER_PAYOUT_ACCOUNT_ID=

# --- Demo Publisher classifier (Phase 4/5 - not used yet) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Advertiser agents (Phase 4 - not used yet) ---
# Each agent is independently configured (CLAUDE.md section 16: one agent =
# one campaign + one Hedera payer wallet). Fill in one block per agent.
NOVABOOK_HEDERA_ACCOUNT_ID=0.0.xxxxx
NOVABOOK_HEDERA_PRIVATE_KEY=0x...
NOVABOOK_CAMPAIGN_ID=
NOVABOOK_MAX_PRICE_TINYBAR=150000
NOVABOOK_RUN_BUDGET_TINYBAR=1000000

FLYLITE_HEDERA_ACCOUNT_ID=0.0.xxxxx
FLYLITE_HEDERA_PRIVATE_KEY=0x...
FLYLITE_CAMPAIGN_ID=
FLYLITE_MAX_PRICE_TINYBAR=150000
FLYLITE_RUN_BUDGET_TINYBAR=1000000

PACE_HEDERA_ACCOUNT_ID=0.0.xxxxx
PACE_HEDERA_PRIVATE_KEY=0x...
PACE_CAMPAIGN_ID=
PACE_MAX_PRICE_TINYBAR=150000
PACE_RUN_BUDGET_TINYBAR=1000000
