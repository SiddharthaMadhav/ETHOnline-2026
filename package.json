{
  "name": "hark-protocol",
  "private": true,
  "version": "0.1.0",
  "description": "Hark Protocol - open intent advertising protocol with x402 machine payments on Hedera",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "postinstall": "pnpm --filter @hark-protocol/protocol run build && pnpm --filter @hark-protocol/db run build && pnpm --filter @hark-protocol/sdk run build",
    "dev": "pnpm --filter @hark-protocol/api dev",
    "build": "pnpm -r run build",
    "start": "node apps/api/dist/server.js",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @hark-protocol/db run migrate",
    "db:seed": "pnpm --filter @hark-protocol/db run seed",
    "check:blocky": "pnpm --filter @hark-protocol/scripts run check-blocky",
    "test:live-payment": "pnpm --filter @hark-protocol/scripts run live-payment-smoke",
    "payout:run": "pnpm --filter @hark-protocol/api run payout:run",
    "agent:novabook": "pnpm --filter @hark-protocol/agent-runner run start -- --agent novabook --once",
    "agent:flylite": "pnpm --filter @hark-protocol/agent-runner run start -- --agent flylite --once",
    "agent:pace": "pnpm --filter @hark-protocol/agent-runner run start -- --agent pace --once",
    "agent:novabook:bulk": "pnpm --filter @hark-protocol/agent-runner run start -- --agent novabook --bulk",
    "agent:flylite:bulk": "pnpm --filter @hark-protocol/agent-runner run start -- --agent flylite --bulk",
    "agent:pace:bulk": "pnpm --filter @hark-protocol/agent-runner run start -- --agent pace --bulk"
  }
}
